{
    "name": "dbseller/php-formula-interpreter",
    "description": "Formula interpreter for PHP",
    "keywords": [
        "php"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "mormat",
            "email": "mormat@free.fr"
        },
        {
            "name": "Gabriel Morgado",
            "email": "gabriel.morgado@dbseller.com.br"
        }
    ],
    "require-dev": {
        "symfony/class-loader": "2.1.*"
    },
    "autoload": {
        "psr-0": {
            "FormulaInterpreter": "src/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5"
    },
    "replace": {
        "mormat/php-formula-interpreter": "self.version"
    },
    "version": "1.0.1"
}
